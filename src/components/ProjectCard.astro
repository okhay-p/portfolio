---
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  project: {
    name: string; color: string; image: string; alt: string; status: string;
    detail: string; description: string; url?: string; repoUrl?: string; writeup?: string; writeupLabel?: string;
  };
}
const { project } = Astro.props;
---
<article class="collection-card">
  {project.url ? (
    <a class="project-primary" href={project.url} target="_blank" rel="noopener noreferrer">
      <ProjectVisual project={project} />
    </a>
  ) : <ProjectVisual project={project} />}
  <p class="project-description">{project.description}</p>
  {(project.writeup || project.repoUrl) && (
    <div class="project-links">
      {project.writeup && <a href={project.writeup}>{project.writeupLabel || 'What I learned'}</a>}
      {project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">View code on GitHub ↗</a>}
    </div>
  )}
</article>
