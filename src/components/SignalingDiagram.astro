<g class="steps" aria-hidden="true"><g class="step"><circle cx="95" cy="135" r="10"/><text x="95" y="139" text-anchor="middle">1</text></g><g class="step"><circle cx="212" cy="107" r="10"/><text x="212" y="111" text-anchor="middle">2</text></g><g class="step"><circle cx="230" cy="267" r="10"/><text x="230" y="271" text-anchor="middle">3</text></g><g class="step"><circle cx="234" cy="170" r="10"/><text x="234" y="174" text-anchor="middle">4</text></g><g class="step"><circle cx="170" cy="166" r="10"/><text x="170" y="170" text-anchor="middle">5</text></g></g>
