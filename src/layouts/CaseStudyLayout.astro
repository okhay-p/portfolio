---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import WritingHeader from '../components/WritingHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../writing.css';

interface Props {
  entry: CollectionEntry<'writing'>;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const { title, description, project, tags, learningGoal, image, liveUrl, sourceUrl } = entry.data;
const contents = headings.filter(heading => heading.depth === 2);
---
<BaseLayout title={`${title} — Oakkar Phyo`} description={description} image={image} article>
  <div class="writing-shell">
    <WritingHeader />
    <main id="main-content">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/#work">Projects</a><span aria-hidden="true">/</span><a href="/writing">Learning notes</a><span aria-hidden="true">/</span><span aria-current="page">{project}</span></nav>
      <header class="case-intro">
        <h1>{title}</h1>
        <p>{description}</p>
        <ul class="writing-tags" aria-label="Topics">{tags.map(tag => <li>{tag}</li>)}</ul>
        <div class="writing-links">
          {liveUrl && <a href={liveUrl} target="_blank" rel="noopener noreferrer">Try {project}</a>}
          {sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener noreferrer">View source</a>}
        </div>
      </header>
      <div class="case-layout">
        <nav class="case-contents" aria-label="Writeup contents">
          <p>In this writeup</p>
          <a href="#learning-goal">The learning goal</a>
          {contents.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
        <article class="case-body">
          <aside class="learning-goal" id="learning-goal" aria-labelledby="goal-title"><h2 id="goal-title">The learning goal</h2><p>{learningGoal}</p></aside>
          <div class="prose"><slot /></div>
          <div class="article-back"><a href="/writing">More learning notes</a><a href="/#work">Back to projects</a></div>
        </article>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
