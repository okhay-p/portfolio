---
import BaseLayout from '../layouts/BaseLayout.astro';
import Niche from '../components/Niche.astro';
import Placard from '../components/Placard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { exhibits } from '../data/exhibits.js';
import '../cabinet.css';
const skills = ['TypeScript', 'React', 'Astro', 'Go', 'Python'];
const agents = [
  { name: 'Hermes', logo: 'hermes.svg' },
  { name: 'OpenCode', logo: 'opencode.svg' },
  { name: 'Codex', logo: 'codex.png' },
];
const number = (index: number) => `No. ${String(index + 1).padStart(2, '0')}`;
---
<BaseLayout title="Oakkar Phyo — Student & curious builder" description="Oakkar Phyo, a first-year Computer Science student at Singapore Management University. A small museum of tools, personal projects, and learning by building.">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <div class="museum">
    <header class="museum-header">
      <a class="wordmark" href="/">oakkar</a>
      <nav aria-label="Site"><a href="/writing">Learning notes</a><a href="https://www.linkedin.com/in/oakkarphyo/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/okhay-p" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </header>
    <main id="main-content">
      <section class="stage" id="work" aria-labelledby="museum-title">
        <div class="intro">
          <p class="intro-eyebrow">Learning by building</p>
          <h1 id="museum-title">A small museum of things I built.</h1>
          <p>Hi, I’m Oakkar, a first-year Computer Science student at SMU. Pick anything off the shelf.</p>
        </div>
        <div class="scene" data-scene>
          <div class="cabinet">
            <div class="crown" aria-hidden="true">The collection</div>
            <div class="shelves" data-shelves>
              {exhibits.map((exhibit, index) => <Niche exhibit={exhibit} number={number(index)} eager={index < 3} />)}
            </div>
            <div class="plinth" aria-hidden="true"></div>
          </div>
          <div class="curator" aria-hidden="true">
            <p class="bubble" data-bubble>Welcome in. Have a look around.</p>
            <img src="/images/oakkar-cutout.webp" alt="" width="490" height="1364" fetchpriority="high" />
          </div>
        </div>
        <div class="floor" aria-hidden="true"></div>
      </section>

      <section class="catalogue" id="catalogue" aria-labelledby="catalogue-title" data-catalogue>
        <div class="catalogue-bar">
          <h2 id="catalogue-title">The catalogue</h2>
          <span class="catalogue-count" data-count></span>
          <button type="button" class="catalogue-close" data-close>Close <span aria-hidden="true">✕</span></button>
        </div>
        {exhibits.map((exhibit, index) => <Placard exhibit={exhibit} number={number(index)} />)}
        <div class="catalogue-nav">
          <button type="button" data-step="-1">← Previous</button>
          <span aria-hidden="true"><kbd>←</kbd> <kbd>→</kbd> <kbd>Esc</kbd></span>
          <button type="button" data-step="1">Next →</button>
        </div>
      </section>

      <section class="curator-note" id="about" aria-labelledby="note-title">
        <div>
          <p class="label">Curator’s note</p>
          <h2 id="note-title">Everything here started as a small problem.</h2>
          <p>I’m a first-year Computer Science student at Singapore Management University. I build small tools, learn things along the way, and occasionally make life a little easier. Mostly because I can.</p>
          <p>Off the shelf, I play football. I also used to make 3D models and animations, which is probably why my portfolio ended up looking like a display case.</p>
          <div class="visitors"><b>Visitor’s book</b><div><a href="https://www.linkedin.com/in/oakkarphyo/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/okhay-p" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div>
        </div>
        <div id="skills">
          <p class="label">Tools of the trade</p>
          <ul class="tools" aria-label="Development">{skills.map(name => <li>{name}</li>)}</ul>
          <p class="label">AI-assisted development</p>
          <ul class="tools" aria-label="AI-assisted development">{agents.map(({ name, logo }) => (
            <li><img src={`/images/logos/${logo}`} alt="" width="16" height="16" />{name}</li>
          ))}</ul>
        </div>
      </section>
    </main>
    <div class="museum-footer"><SiteFooter /></div>
    <div class="dim" data-dim></div>
  </div>
  <script>
    import { initializeCabinet } from '../cabinet.js';
    initializeCabinet(document.querySelector('.museum'));
  </script>
</BaseLayout>
