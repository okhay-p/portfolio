---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects.js';
import { repositories } from '../github-repositories.js';
const skills = ['TypeScript', 'React', 'Astro', 'Go', 'Python'];
const agents = [
  { name: 'Hermes', logo: 'hermes.svg' },
  { name: 'OpenCode', logo: 'opencode.svg' },
  { name: 'Codex', logo: 'codex.png' },
];
---
<BaseLayout title="Oakkar Phyo — Student & curious builder" description="Oakkar Phyo, a first-year Computer Science student at Singapore Management University. Small tools, personal projects, and learning by building.">
  <div class="c-layout">
    <aside class="c-sidebar">
      <a class="wordmark" href="/">oakkar</a>
      <div>
        <span class="eyebrow">DEVELOPER. BUILDER.<br />OCCASIONAL DAYDREAMER.</span>
        <h1>Learning by<br />building.</h1>
        <p>First-year Computer Science student at Singapore Management University.</p>
        <span class="status"><i></i> Currently learning &amp; building</span>
      </div>
      <nav class="c-sidebar-bottom" aria-label="Portfolio">
        <a href="#about">A bit about me</a>
        <a href="#skills">My toolkit</a>
        <a href="/writing">Learning notes</a>
        <div class="c-sidebar-socials">
          <a href="https://www.linkedin.com/in/oakkarphyo/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/okhay-p" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <span>LEARNING / BUILDING / EXPLORING</span>
      </nav>
    </aside>
    <main class="c-content" id="main-content">
      <div class="c-heading"><span>THE COLLECTION</span><span>SMALL TOOLS &amp; SIDE QUESTS</span></div>
      <div class="collection" id="work">
        <div class="collection-card card-large">
          <div class="collection-art blue">
            <div class="scene portrait"><img src="/images/oakkar-character-v2.png" alt="Full-length stylized character of Oakkar with curly hair, silver glasses, a black hoodie, and black sneakers" width="1122" height="1402" fetchpriority="high" /></div>
            <span class="collection-sticker">A LITTLE HUMAN TOUCH</span>
          </div>
          <div class="collection-meta"><div><h2>Hello, I’m Oakkar.</h2><p>Learning things. Making things. Mostly because I can.</p></div></div>
        </div>
        {projects.map(project => <ProjectCard project={project} />)}
      </div>
      <section class="skills-section" id="skills">
        <div class="eyebrow">HOW I BUILD</div>
        <div class="skills-intro"><h2>A curious mind.<br />A practical toolkit.</h2><p>Code, craft, and AI-assisted development.</p></div>
        <div class="skills-groups">
          <div><h3>Development</h3><div class="skill-tags">{skills.map(name => <span>{name}</span>)}</div></div>
          <div><h3>AI-assisted development</h3><div class="skill-tags agent-tags">{agents.map(({ name, logo }) => (
            <span><img class:list={['agent-logo', `${name.toLowerCase()}-logo`]} src={`/images/logos/${logo}`} alt="" aria-hidden="true" width="24" height="24" />{name}</span>
          ))}</div></div>
        </div>
      </section>
      <section class="repository-section" id="repositories">
        <div class="section-heading"><h2>Public repositories <span>/ {repositories.length}</span></h2><a class="github-profile" href="https://github.com/okhay-p" target="_blank" rel="noopener noreferrer">More on GitHub ↗</a></div>
        <div class="repo-list">{repositories.map(repo => (
          <a href={repo.url} target="_blank" rel="noopener noreferrer"><span class="repo-name">{repo.name}</span><span class="repo-language">{repo.primaryLanguage?.name || 'Resources'}</span><span aria-hidden="true">↗</span></a>
        ))}</div>
      </section>
      <section class="c-about" id="about">
        <h2>A curious mind.<br />A hands-on approach.</h2>
        <p>I’m Oakkar, a first-year Computer Science student at Singapore Management University. I build small tools, learn things along the way, and occasionally make life a little easier. Mostly because I can.</p>
        <p>Outside of code, I play football. I also used to make 3D models and animations—some of that past life lives on Instagram.</p>
        <a class="instagram-card" href="https://www.instagram.com/noooidea.creative/" target="_blank" rel="noopener noreferrer" aria-label="See my past 3D models and animations on Instagram">
          <img src="/images/instagram-creative-card-v1.png" alt="A miniature gallery inspired by my 3D renders: a riverside shop, snowman, moon-and-stars switch, and framed abstract print" width="1536" height="1024" loading="lazy" />
          <div class="instagram-card-caption"><div><h3>A past life in polygons.</h3><span>@noooidea.creative · 3D &amp; animation</span></div><span aria-hidden="true">↗</span></div>
        </a>
        <div class="about-socials"><a class="github-profile" href="https://www.linkedin.com/in/oakkarphyo/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="github-profile" href="https://github.com/okhay-p" target="_blank" rel="noopener noreferrer">More on GitHub ↗</a></div>
      </section>
      <SiteFooter />
    </main>
  </div>
  <script>
    import { initializeMotion } from '../motion.js';
    initializeMotion(document.querySelector('.c-layout'));
  </script>
</BaseLayout>
